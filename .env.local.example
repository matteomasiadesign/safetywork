# ==============================================================================
# SAFETY WORK S.R.L.S. - CONFIGURAZIONE
# Copia questo file in .env.local (locale) e imposta le stesse variabili su Vercel.
# ==============================================================================

# Supabase -> Project Settings -> API
# Entrambe sono PUBBLICHE per progetto (finiscono nel browser): a proteggere i dati
# sono le policy RLS del database, non queste chiavi.
NEXT_PUBLIC_SUPABASE_URL=https://<id-progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chiave anon / publishable>

# NON aggiungere qui la service_role key con prefisso NEXT_PUBLIC_: darebbe pieno
# accesso al database a chiunque. Al momento non serve.
